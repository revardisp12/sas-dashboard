# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# real customer data exports — NEVER commit (PII). test-*.csv fixtures are fine.
/public/*.csv
!/public/test-*.csv

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Supabase CLI temp files
supabase/.temp

# iCloud Drive sync-conflict copies (this repo lives under iCloud Drive) — a file edited
# from two "clients" at once gets a " 2", " 3", etc suffix copy. These are pure iCloud
# noise, never real project files; ignore so they can't be accidentally `git add`ed again.
* 2.*
* 3.*
